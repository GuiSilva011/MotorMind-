generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// OFICINA / TENANT
// ======================================================

model Oficina {
  id Int @id @default(autoincrement())

  nomeFantasia String  @db.VarChar(120)
  razaoSocial  String? @db.VarChar(150)
  cnpj         String? @unique @db.VarChar(18)

  email    String? @db.VarChar(120)
  telefone String? @db.VarChar(20)
  whatsapp String? @db.VarChar(20)

  cep         String? @db.VarChar(9)
  endereco    String? @db.VarChar(120)
  numero      String? @db.VarChar(10)
  complemento String? @db.VarChar(80)
  bairro      String? @db.VarChar(60)
  cidade      String? @db.VarChar(60)
  uf          String? @db.VarChar(2)

  logoUrl String?

  status StatusOficina @default(PENDENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios             Usuario[]
  clientes             Cliente[]
  veiculos             Veiculo[]
  agendamentos         Agendamento[]
  diagnosticosCatalogo DiagnosticoCatalogo[]
  servicosCatalogo     ServicoCatalogo[]
  pecasCatalogo        PecaCatalogo[]
  fornecedores         Fornecedor[]
  ordensServico        OrdemServico[]
  checklists           Checklist[]
  funcionarios         Funcionario[]

  estoquePecas         EstoquePeca[]
  estoqueMovimentacoes EstoqueMovimentacao[]
  alertasEstoque       AlertaEstoque[]
  atribuicoesOrdem     OrdemServicoAtribuicao[]
  requisicoesPeca      RequisicaoPeca[]
  conversasTicket      ConversaTicket[]
  mensagensTicket      MensagemTicket[]
  notificacoes         Notificacao[]

  licenca      Licenca?
  configuracao ConfiguracaoOficina?
  confirmacoesEmail ConfirmacaoEmailOficina[]
}

enum StatusOficina {
  PENDENTE
  ATIVA
  SUSPENSA
  CANCELADA
}

// ======================================================
// CONFIGURAÇÕES DA OFICINA
// ======================================================

model ConfiguracaoOficina {
  id Int @id @default(autoincrement())

  oficinaId Int     @unique
  oficina   Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  notificarEstoqueEmail   Boolean @default(true)
  notificarEstoqueSistema Boolean @default(true)
  notificarTicketsSistema Boolean @default(true)
  notificarChatSistema    Boolean @default(true)

  emailNotificacaoEstoque String? @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// LICENÇA / COMPRA
// ======================================================

model Licenca {
  id Int @id @default(autoincrement())

  oficinaId Int     @unique
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  status StatusLicenca @default(PENDENTE)

  valor Decimal? @db.Decimal(10, 2)

  codigoCompra String? @unique @db.VarChar(100)

  compradaEm  DateTime?
  ativadaEm   DateTime?
  canceladaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatusLicenca {
  PENDENTE
  ATIVA
  CANCELADA
}

// ======================================================
// USUÁRIO
// ======================================================

model Usuario {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  Nome  String
  Email String @unique
  Senha String
  Role  Role

  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  funcionario Funcionario?
  confirmacoesEmail ConfirmacaoEmailOficina[]

  ordensComoOperador OrdemServico[] @relation("OrdemOperador")
  ordensComoTecnico  OrdemServico[] @relation("OrdemTecnico")

  atribuicoesComoTecnico OrdemServicoAtribuicao[] @relation("AtribuicaoTecnico")
  atribuicoesCriadas     OrdemServicoAtribuicao[] @relation("AtribuicaoCriadaPor")

  requisicoesSolicitadas  RequisicaoPeca[] @relation("RequisicaoSolicitante")
  requisicoesResponsaveis RequisicaoPeca[] @relation("RequisicaoResponsavel")

  mensagensTicket      MensagemTicket[]
  movimentacoesEstoque EstoqueMovimentacao[]
  notificacoesUsuario  NotificacaoUsuario[]

  @@index([oficinaId])
}

enum Role {
  OWNER
  ADMIN
  OPERADOR
  TECNICO
}

model ConfirmacaoEmailOficina {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  email String @db.VarChar(120)
  tokenHash String @unique @db.VarChar(64)
  expiraEm DateTime
  criadoEm DateTime @default(now())
  enviadoEm DateTime?
  consumidoEm DateTime?
  invalidadoEm DateTime?

  @@index([oficinaId, criadoEm])
  @@index([usuarioId])
}

// ======================================================
// CLIENTE
// ======================================================

model Cliente {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  nome           String
  cpf            String?   @db.VarChar(11)
  email          String?
  dataNascimento DateTime?

  cep         String?
  endereco    String?
  bairro      String?
  cidade      String?
  uf          String? @db.VarChar(2)
  numero      String?
  complemento String?

  celular String?

  createdAt DateTime @default(now())

  veiculos     Veiculo[]
  agendamentos Agendamento[]

  @@index([oficinaId])
}

// ======================================================
// VEÍCULO
// ======================================================

model Veiculo {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  placa          String   @db.VarChar(7)
  chassi         String?  @db.VarChar(17)
  modelo         String?
  fabricante     String?
  ano_modelo     Int?
  ano_fabricacao Int?
  cambio         String?
  motor          String?
  km             String?
  cor            String?
  ar             Boolean?

  createdAt DateTime @default(now())

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  agendamentos  Agendamento[]
  ordensServico OrdemServico[]
  checklists    Checklist[]

  @@unique([oficinaId, placa])
  @@index([oficinaId])
  @@index([clienteId])
}

// ======================================================
// AGENDAMENTO
// ======================================================

model Agendamento {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id])

  dataHora     DateTime
  mecanico     String?
  tipo_servico String?
  servico      String

  status StatusAgendamento @default(AGENDADO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([oficinaId])
  @@index([clienteId])
  @@index([veiculoId])
  @@index([dataHora])
}

enum StatusAgendamento {
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

// ======================================================
// CATÁLOGO DE DIAGNÓSTICOS
// ======================================================

model DiagnosticoCatalogo {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  codigo    String  @db.VarChar(20)
  nome      String  @db.VarChar(80)
  descricao String? @db.VarChar(255)

  ordensDiagnosticos OrdemDiagnostico[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([oficinaId, codigo])
  @@index([oficinaId])
}

// ======================================================
// CATÁLOGO DE SERVIÇOS
// ======================================================

model ServicoCatalogo {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  codigo      String   @db.VarChar(20)
  nome        String   @db.VarChar(80)
  categoria   String?  @db.VarChar(50)
  valorPadrao Decimal? @db.Decimal(10, 2)

  ordensServicos OrdemServicoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([oficinaId, codigo])
  @@index([oficinaId])
}

// ======================================================
// CATÁLOGO DE PEÇAS DA OS
// ======================================================

model PecaCatalogo {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  codigo    String  @db.VarChar(20)
  nome      String  @db.VarChar(80)
  marca     String? @db.VarChar(50)
  aplicacao String? @db.VarChar(120)
  grupo     String? @db.VarChar(50)
  unidade   String? @default("UN") @db.VarChar(10)

  ordensPecas OrdemPecaItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([oficinaId, codigo])
  @@index([oficinaId])
}

// ======================================================
// PEÇAS DA ORDEM DE SERVIÇO
// ======================================================

model OrdemPecaItem {
  id Int @id @default(autoincrement())

  ordemServicoId     Int
  ordemDiagnosticoId Int?
  ordemServicoItemId Int?

  pecaCatalogoId Int?
  estoquePecaId  Int?

  codigoPeca String? @db.VarChar(20)
  nomePeca   String  @db.VarChar(80)

  fornecedorId   Int?
  fornecedorNome String? @db.VarChar(80)

  quantidade    Int      @default(1)
  custoUnitario Decimal? @db.Decimal(10, 2)
  desconto      Decimal? @db.Decimal(10, 2)
  valorTotal    Decimal? @db.Decimal(10, 2)

  codigoVisual     String? @db.VarChar(10)
  codigoHierarquia String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordemServico     OrdemServico      @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  ordemDiagnostico OrdemDiagnostico? @relation(fields: [ordemDiagnosticoId], references: [id], onDelete: Cascade)
  ordemServicoItem OrdemServicoItem? @relation(fields: [ordemServicoItemId], references: [id], onDelete: Cascade)
  pecaCatalogo     PecaCatalogo?     @relation(fields: [pecaCatalogoId], references: [id])
  estoquePeca      EstoquePeca?      @relation(fields: [estoquePecaId], references: [id], onDelete: SetNull)

  @@index([ordemServicoId])
  @@index([ordemDiagnosticoId])
  @@index([ordemServicoItemId])
  @@index([pecaCatalogoId])
  @@index([estoquePecaId])
}

// ======================================================
// FORNECEDOR
// ======================================================

model Fornecedor {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  codigo String @db.VarChar(20)

  nome      String  @db.VarChar(100)
  cnpj      String  @db.VarChar(18)
  email     String? @db.VarChar(100)
  telefone  String? @db.VarChar(20)
  celular   String? @db.VarChar(20)
  inscricao String? @db.VarChar(30)

  cep         String? @db.VarChar(9)
  endereco    String? @db.VarChar(120)
  numero      String? @db.VarChar(10)
  uf          String? @db.VarChar(2)
  bairro      String? @db.VarChar(60)
  cidade      String? @db.VarChar(60)
  complemento String? @db.VarChar(80)

  fornecePecas    Boolean @default(true)
  forneceServicos Boolean @default(false)
  observacoes     String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requisicoesItens RequisicaoPecaItem[]

  @@unique([oficinaId, codigo])
  @@unique([oficinaId, cnpj])
  @@index([oficinaId])
}

// ======================================================
// ORDEM DE SERVIÇO
// ======================================================

model OrdemServico {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  codigo String      @db.VarChar(20)
  status StatusOrdem @default(ABERTA)

  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id])

  operadorId Int?
  operador   Usuario? @relation("OrdemOperador", fields: [operadorId], references: [id], onDelete: SetNull)

  tecnicoId Int?
  tecnico   Usuario? @relation("OrdemTecnico", fields: [tecnicoId], references: [id], onDelete: SetNull)

  observacoes    String?   @db.VarChar(255)
  dataEmissao    DateTime  @default(now())
  dataFechamento DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diagnosticos OrdemDiagnostico[]
  servicos     OrdemServicoItem[]
  pecas        OrdemPecaItem[]

  atribuicoesTecnico OrdemServicoAtribuicao[]
  requisicoesPeca    RequisicaoPeca[]
  notificacoes       Notificacao[]
  movimentacoesEstoque EstoqueMovimentacao[]

  @@unique([oficinaId, codigo])
  @@index([oficinaId])
  @@index([veiculoId])
  @@index([operadorId])
  @@index([tecnicoId])
}

enum StatusOrdem {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PECA
  FINALIZADA
  FECHADA
  CANCELADA
}

// ======================================================
// HISTÓRICO DE ATRIBUIÇÃO DA OS AO MECÂNICO
// ======================================================

model OrdemServicoAtribuicao {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  ordemServicoId Int
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  tecnicoId Int
  tecnico   Usuario @relation("AtribuicaoTecnico", fields: [tecnicoId], references: [id])

  atribuidoPorId Int
  atribuidoPor   Usuario @relation("AtribuicaoCriadaPor", fields: [atribuidoPorId], references: [id])

  ativa Boolean @default(true)

  atribuidoEm DateTime  @default(now())
  encerradoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([oficinaId])
  @@index([ordemServicoId])
  @@index([tecnicoId])
  @@index([ativa])
}

// ======================================================
// DIAGNÓSTICOS DA ORDEM
// ======================================================

model OrdemDiagnostico {
  id Int @id @default(autoincrement())

  ordemServicoId        Int
  diagnosticoCatalogoId Int?

  codigoVisual     String? @db.VarChar(10)
  codigoHierarquia String? @db.VarChar(20)

  nomeDiagnostico String  @db.VarChar(80)
  descricao       String? @db.VarChar(255)
  observacoes     String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordemServico        OrdemServico         @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  diagnosticoCatalogo DiagnosticoCatalogo? @relation(fields: [diagnosticoCatalogoId], references: [id])

  servicos OrdemServicoItem[]
  pecas    OrdemPecaItem[]

  @@index([ordemServicoId])
  @@index([diagnosticoCatalogoId])
}

// ======================================================
// SERVIÇOS DA ORDEM
// ======================================================

model OrdemServicoItem {
  id Int @id @default(autoincrement())

  ordemServicoId     Int
  ordemDiagnosticoId Int?
  servicoCatalogoId  Int?

  codigoVisual     String? @db.VarChar(10)
  codigoHierarquia String? @db.VarChar(20)

  nomeServico String  @db.VarChar(80)
  descricao   String? @db.VarChar(255)
  responsavel String? @db.VarChar(80)
  tipo        String? @db.VarChar(50)

  precoVenda Decimal? @db.Decimal(10, 2)
  desconto   Decimal? @db.Decimal(10, 2)
  valorTotal Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordemServico     OrdemServico      @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  ordemDiagnostico OrdemDiagnostico? @relation(fields: [ordemDiagnosticoId], references: [id], onDelete: Cascade)
  servicoCatalogo  ServicoCatalogo?  @relation(fields: [servicoCatalogoId], references: [id])

  pecas OrdemPecaItem[]

  @@index([ordemServicoId])
  @@index([ordemDiagnosticoId])
  @@index([servicoCatalogoId])
}

// ======================================================
// CHECKLIST
// ======================================================

model Checklist {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id])

  itensEntrada           Json?
  itensDiagnostico       Json?
  observacoesEntrada     String? @db.VarChar(1000)
  observacoesDiagnostico String? @db.VarChar(1000)

  fotoFrente   String?
  fotoTraseira String?
  fotoEsquerda String?
  fotoDireita  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([oficinaId])
  @@index([veiculoId])
}

// ======================================================
// FUNCIONÁRIO
// ======================================================

model Funcionario {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  Cpf            String?
  Rg             String?
  DataNascimento DateTime?
  Celular        String?
  Ctps           String?

  Cep         String?
  Endereco    String?
  Numero      String?
  Uf          String?
  Bairro      String?
  Cidade      String?
  Complemento String?

  DataAdmissao DateTime?

  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  @@unique([oficinaId, Cpf])
  @@index([oficinaId])
}

// ======================================================
// ESTOQUE - INDEPENDENTE DO PecaCatalogo DA OS
// ======================================================

model EstoquePeca {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  codigo String @db.VarChar(20)
  nome   String @db.VarChar(100)

  marca     String? @db.VarChar(60)
  aplicacao String? @db.VarChar(150)
  unidade   String  @default("UN") @db.VarChar(10)

  quantidadeAtual  Int @default(0)
  quantidadeMinima Int @default(0)

  localizacao String? @db.VarChar(80)
  ativo       Boolean @default(true)

  alertaAtivo    Boolean   @default(false)
  ultimoAlertaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimentacoes    EstoqueMovimentacao[]
  ordensPecas      OrdemPecaItem[]
  requisicoesItens RequisicaoPecaItem[]
  alertas          AlertaEstoque[]

  @@unique([oficinaId, codigo])
  @@index([oficinaId])
  @@index([quantidadeAtual])
}

model EstoqueMovimentacao {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  estoquePecaId Int
  estoquePeca   EstoquePeca @relation(fields: [estoquePecaId], references: [id])

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  requisicaoItemId Int?
  requisicaoItem   RequisicaoPecaItem? @relation(fields: [requisicaoItemId], references: [id], onDelete: SetNull)

  ordemServicoId Int?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)

  tipo TipoMovimentacaoEstoque

  quantidade          Int
  quantidadeAnterior  Int
  quantidadePosterior Int

  observacao String? @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([oficinaId])
  @@index([estoquePecaId])
  @@index([usuarioId])
  @@index([requisicaoItemId])
  @@index([ordemServicoId])
  @@index([createdAt])
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  SAIDA_REQUISICAO
  SAIDA_OS
  DEVOLUCAO
  DEVOLUCAO_OS
  AJUSTE_ENTRADA
  AJUSTE_SAIDA
}

model AlertaEstoque {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  estoquePecaId Int
  estoquePeca   EstoquePeca @relation(fields: [estoquePecaId], references: [id])

  status StatusAlertaEstoque @default(ATIVO)

  quantidadeDetectada Int
  quantidadeMinima    Int

  emailEnviadoEm DateTime?
  resolvidoEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificacoes Notificacao[]

  @@index([oficinaId])
  @@index([estoquePecaId])
  @@index([status])
}

enum StatusAlertaEstoque {
  ATIVO
  RESOLVIDO
}

// ======================================================
// TICKET DE SOLICITAÇÃO DE PEÇAS
// ======================================================

model RequisicaoPeca {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  codigo String @db.VarChar(20)

  ordemServicoId Int
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Restrict)

  solicitanteId Int
  solicitante   Usuario @relation("RequisicaoSolicitante", fields: [solicitanteId], references: [id])

  responsavelId Int?
  responsavel   Usuario? @relation("RequisicaoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  status StatusRequisicaoPeca @default(ABERTA)

  observacao String? @db.VarChar(1000)
  chaveAbertura String? @db.VarChar(36)

  abertaEm    DateTime  @default(now())
  assumidaEm  DateTime?
  concluidaEm DateTime?
  canceladaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens        RequisicaoPecaItem[]
  conversa     ConversaTicket?
  notificacoes Notificacao[]
  historico RequisicaoPecaHistorico[]

  @@unique([oficinaId, codigo])
  @@unique([oficinaId, solicitanteId, chaveAbertura])
  @@index([oficinaId])
  @@index([ordemServicoId])
  @@index([solicitanteId])
  @@index([responsavelId])
  @@index([status])
}

model RequisicaoPecaHistorico {
  id Int @id @default(autoincrement())
  requisicaoPecaId Int
  requisicaoPeca RequisicaoPeca @relation(fields: [requisicaoPecaId], references: [id], onDelete: Restrict)
  usuarioId Int
  statusAnterior StatusRequisicaoPeca?
  statusAtual StatusRequisicaoPeca
  motivo String? @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([requisicaoPecaId, createdAt])
}

enum StatusRequisicaoPeca {
  ABERTA
  EM_ATENDIMENTO
  AGUARDANDO_PECA
  DISPONIVEL
  ENTREGUE
  CANCELADA
}

model RequisicaoPecaItem {
  id Int @id @default(autoincrement())

  requisicaoPecaId Int
  requisicaoPeca   RequisicaoPeca @relation(fields: [requisicaoPecaId], references: [id], onDelete: Cascade)

  estoquePecaId Int?
  estoquePeca   EstoquePeca? @relation(fields: [estoquePecaId], references: [id], onDelete: SetNull)

  fornecedorId Int?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  nomePeca String @db.VarChar(120)

  quantidadeSolicitada Int @default(1)
  quantidadeAtendida   Int @default(0)

  origemAtendimento OrigemAtendimentoPeca?
  observacao        String?                @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movimentacoesEstoque EstoqueMovimentacao[]

  @@index([requisicaoPecaId])
  @@index([estoquePecaId])
  @@index([fornecedorId])
}

enum OrigemAtendimentoPeca {
  ESTOQUE
  COMPRA_FORNECEDOR
}

// ======================================================
// CHAT DO TICKET - MENSAGENS EXPIRAM EM 48 HORAS
// ======================================================

model ConversaTicket {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  requisicaoPecaId Int            @unique
  requisicaoPeca   RequisicaoPeca @relation(fields: [requisicaoPecaId], references: [id], onDelete: Cascade)

  encerradaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mensagens MensagemTicket[]

  @@index([oficinaId])
}

model MensagemTicket {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id])

  conversaId Int
  conversa   ConversaTicket @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  autorId Int
  autor   Usuario @relation(fields: [autorId], references: [id])

  conteudo String? @db.VarChar(2000)
  chaveEnvio String? @db.VarChar(36)

  createdAt DateTime @default(now())
  expiresAt DateTime

  anexos MensagemAnexo[]

  @@unique([conversaId, autorId, chaveEnvio])
  @@index([oficinaId])
  @@index([conversaId])
  @@index([autorId])
  @@index([expiresAt])
}

model MensagemAnexo {
  id Int @id @default(autoincrement())

  mensagemId Int
  mensagem   MensagemTicket @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  url          String  @db.VarChar(500)
  nomeArquivo  String? @db.VarChar(255)
  mimeType     String? @db.VarChar(100)
  tamanhoBytes Int?

  createdAt DateTime @default(now())

  @@index([mensagemId])
}

// ======================================================
// NOTIFICAÇÕES / SINO
// ======================================================

model Notificacao {
  id Int @id @default(autoincrement())

  oficinaId Int
  oficina   Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  tipo TipoNotificacao

  titulo   String @db.VarChar(120)
  mensagem String @db.VarChar(500)

  ordemServicoId Int?
  ordemServico   OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)

  requisicaoPecaId Int?
  requisicaoPeca   RequisicaoPeca? @relation(fields: [requisicaoPecaId], references: [id], onDelete: SetNull)

  alertaEstoqueId Int?
  alertaEstoque   AlertaEstoque? @relation(fields: [alertaEstoqueId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  usuarios NotificacaoUsuario[]

  @@index([oficinaId])
  @@index([tipo])
  @@index([ordemServicoId])
  @@index([requisicaoPecaId])
  @@index([alertaEstoqueId])
  @@index([expiresAt])
  @@index([createdAt])
}

enum TipoNotificacao {
  ESTOQUE_BAIXO
  ORDEM_ATRIBUIDA
  REQUISICAO_PECA
  TICKET_ASSUMIDO
  PECA_DISPONIVEL
  MENSAGEM_TICKET
  SISTEMA
}

model NotificacaoUsuario {
  id Int @id @default(autoincrement())

  notificacaoId Int
  notificacao   Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  lidaEm DateTime?

  createdAt DateTime @default(now())

  @@unique([notificacaoId, usuarioId])
  @@index([usuarioId])
  @@index([lidaEm])
}
